<div class="layout">
<div class="gt gt-col" style="gap: 6px;">
  {%- if auth_err %}
  <div class="gt-banner"><span class="label label--small">Garmin login expired: run gtrmnl login</span></div>
  {%- elsif stale %}
  <div class="gt-banner"><span class="label label--small">No update since {{ ts_hh }}:{{ ts_mi }} ({{ age_h }} h)</span></div>
  {%- endif %}
  <div class="gt-row" style="flex: 1 1 0;">

  {%- case screen %}

  {%- when "latest" %}
    {%- if has_a %}
      {%- if show_route %}
      <div class="gt-route-box" style="width: 190px; flex: none;">
        {%- if use_basemap %}
        {% render "gt_basemap", el: "gt-map-hh", poly: a.p, preset: map_mode %}
        {%- else %}
        {% render "gt_route", r: a.r, rb: a.rb, w: 4 %}
        {%- endif %}
      </div>
      {%- endif %}
      <div class="gt-col" style="flex: 1; gap: 6px; justify-content: center;">
        {%- assign el = a.el | default: 0 %}
        {%- assign km = 0 %}{% if a_has_d %}{% assign km = a_km %}{% endif %}
        {% render "gt_item", c: a.c, name: a_name, km: km, dur: a_dur, el: el, t: a.st, now: now, off: a_off, noff: off %}
        <div class="grid grid--cols-{% if show_route %}3{% else %}4{% endif %} gap--small">
          {%- if show_route %}{% assign stat_max = 3 %}{% else %}{% assign stat_max = 4 %}{% endif %}
          {%- for i in (1..stat_max) %}{% assign k = i | minus: 1 %}{% if k >= st_n %}{% break %}{% endif %}
          {% render "gt_stat", n: st_i[k], v: st_v[k], u: st_u[k], l: st_l[k], size: "xsmall", icon: 20 %}
          {%- endfor %}
        </div>
      </div>
    {%- else %}
      <div class="gt-empty" style="flex: 1;"><span class="label">No activities yet</span></div>
    {%- endif %}

  {%- when "splits" %}
    {%- if spl_n < 2 %}
    <div class="gt-empty" style="flex: 1;">{% render "gt_sym", n: "splits", size: 36 %}<span class="label">No splits for the latest activity</span></div>
    {%- else %}
    <div class="gt-col" style="flex: 1; gap: 4px;">
      <span class="label label--small gt-clip">Splits per {{ a.su }} km · {{ a_name }}</span>
      <div class="gt-chart" style="flex: 1 1 0;">
        <div class="gt-bars">
          {%- for v in sv %}
            {%- assign x = v | plus: 0 %}
            {%- if a.c == "ride" %}{% assign pct = x | times: 100 | divided_by: best %}{% else %}{% assign pct = best | times: 100 | divided_by: x %}{% endif %}
            {%- assign pct = pct | minus: 60 | at_least: 0 | times: 85 | divided_by: 40 | plus: 15 %}
            <div class="gt-bar{% if x == best %} gt-bar--best{% endif %}" style="height: {{ pct }}%;"></div>
          {%- endfor %}
        </div>
      </div>
    </div>
    {%- if a.c == "ride" %}
      {%- assign b = best | divided_by: 10.0 %}{% assign av = spl_avg | divided_by: 10.0 %}{% assign wv = worst | divided_by: 10.0 %}{% assign su = "km/h" %}
    {%- else %}
      {%- capture b %}{% render "gt_pace", p: best %}{% endcapture %}
      {%- capture av %}{% render "gt_pace", p: spl_avg %}{% endcapture %}
      {%- capture wv %}{% render "gt_pace", p: worst %}{% endcapture %}{% assign su = "/km" %}
    {%- endif %}
    <div class="gt-col" style="width: 200px; flex: none; gap: 6px; justify-content: center;">
      {% render "gt_stat", n: "speed", v: b, u: su, l: "Fastest", size: "xsmall", icon: 20 %}
      {% render "gt_stat", n: "speed", v: av, u: su, l: "Average", size: "xsmall", icon: 20 %}
      {% render "gt_stat", n: "speed", v: wv, u: su, l: "Slowest", size: "xsmall", icon: 20 %}
    </div>
    {%- endif %}

  {%- when "heart" %}
    {%- if hr_n < 2 %}
    <div class="gt-empty" style="flex: 1;">{% render "gt_sym", n: "heart", size: 36 %}<span class="label">No heart rate for the latest activity</span></div>
    {%- else %}
    <div class="gt-col" style="flex: 1; gap: 4px;">
      <div class="flex" style="justify-content: space-between;"><span class="label label--small">Heart rate {{ hr_lo }}-{{ hr_hi }}</span><span class="label label--small">avg {{ a.hr }} · max {{ a.mx }} bpm</span></div>
      <div class="gt-chart" style="flex: 1 1 0;">
        <svg viewBox="0 -2 {{ hr_w }} 67" preserveAspectRatio="none">
          <polygon class="gt-hr-fill" points="0,65 {{ hr_pts }}{{ hr_w }},65"/>
          <polyline class="gt-hr" points="{{ hr_pts }}"/>
        </svg>
      </div>
    </div>
    {%- if z_total > 0 %}
    <div class="gt-col" style="width: 190px; flex: none; gap: 3px; justify-content: center;">
      {%- for z in a.z reversed %}
        {%- assign zn = 6 | minus: forloop.index %}
        {%- assign zw = z | times: 100 | divided_by: z_max %}
        {%- assign zp = z | times: 100.0 | divided_by: z_total | round %}
        <div class="flex" style="align-items: center; gap: 6px;">
          <span class="label label--small" style="width: 22px;">Z{{ zn }}</span>
          <div style="flex: 1;"><div class="gt-hbar {% if zn < 3 %}bg--gray-45{% else %}bg--black{% endif %}" style="width: {{ zw }}%; height: 10px;"></div></div>
          <span class="label label--small" style="width: 34px; text-align: right;">{{ zp }}%</span>
        </div>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- endif %}

  {%- when "week" %}
    {%- assign dn = now | plus: off | divided_by: 86400 %}
    {%- assign today_slot = dn | plus: 3 | modulo: 7 | plus: 7 %}
    <div class="gt-col" style="flex: 1; gap: 3px;">
      <div class="gt-cal" style="flex: none; gap: 4px;">
        {%- for nm in wk_days %}<span class="label label--small" style="text-align: center;">{{ nm }}</span>{% endfor %}
      </div>
      <div class="gt-cal" style="flex: 1 1 0; grid-template-rows: 1fr 1fr; gap: 4px; min-height: 0;">
        {%- for i in (0..13) %}
          {%- assign d = days[i] | default: "" %}
          {%- assign letter = d | slice: 0, 1 %}
          {%- assign dkm = d | slice: 1, 9 %}
          {%- case letter %}
            {%- when "r" %}{% assign dc = "run" %}
            {%- when "b" %}{% assign dc = "ride" %}
            {%- when "h" %}{% assign dc = "hike" %}
            {%- when "w" %}{% assign dc = "walk" %}
            {%- when "s" %}{% assign dc = "swim" %}
            {%- when "g" %}{% assign dc = "strength" %}
            {%- when "k" %}{% assign dc = "ski" %}
            {%- else %}{% assign dc = "other" %}
          {%- endcase %}
          {%- if letter == "." %}
          <div class="gt-day gt-day--future"></div>
          {%- elsif d == "" %}
          <div class="gt-day gt-day--rest{% if i == today_slot %} gt-day--today{% endif %}"></div>
          {%- else %}
          <div class="gt-day{% if i == today_slot %} gt-day--today{% endif %}" style="flex-direction: row; gap: 4px;">
            {% render "gt_sym", n: dc, size: 18 %}
            {%- if dkm != "" %}<span class="label label--small">{{ dkm }}</span>{% endif %}
          </div>
          {%- endif %}
        {%- endfor %}
      </div>
    </div>
    <div class="flex" style="width: 280px; flex: none; gap: 8px; align-items: flex-end;">
      {%- for cat in wk_cats %}
        {%- assign lk = "l" | append: cat %}
        {%- assign tw = wk[cat][0] | default: 0 %}
        {%- assign lw = wk[lk][0] | default: 0 %}
        {%- assign ltd = wk[lk][2] | default: 0 %}
        {%- if tw > 0 or lw > 0 %}
        {% render "gt_cmp", c: cat, tw: tw, lw: lw, ltd: ltd, h: 60 %}
        {%- endif %}
      {%- endfor %}
    </div>

  {%- when "recovery" %}
    {%- capture bb_n %}{% if w.bbh %}high {{ w.bbh }}{% endif %}{% endcapture %}
    {%- capture sl_n %}{% if w.ss %}{% render "gt_dur", s: w.ss %}{% endif %}{% endcapture %}
    <div class="gt-col" style="flex: 1; gap: 4px; justify-content: center;">
      {% render "gt_meter", n: "battery", l: "Body battery", v: w.bb, note: bb_n, sz: "base" %}
      {% render "gt_meter", n: "sleep", l: "Sleep", v: w.sl, note: sl_n, sz: "base" %}
      {% render "gt_meter", n: "readiness", l: "Readiness", v: w.tr, note: "", sz: "base" %}
    </div>
    <div class="gt-col" style="width: 210px; flex: none; gap: 6px; justify-content: center;">
      {%- capture hv_l %}HRV{% if hrv_name != "" %} · {{ hrv_name }}{% endif %}{% endcapture %}
      {% render "gt_stat", n: "hrv", v: w.hv, u: "ms", l: hv_l, size: "xsmall", icon: 20 %}
      {% render "gt_stat", n: "recovery", v: w.rc, u: "h", l: "Recovery", size: "xsmall", icon: 20 %}
      {%- assign st_v_ = st_name | default: "-" %}
      {% render "gt_stat", n: "status", v: st_v_, u: "", l: "Training status", size: "xsmall", icon: 20 %}
    </div>
  {%- endcase %}
  </div>
</div>
</div>
{% render "gt_bar", instance: screen_name %}
