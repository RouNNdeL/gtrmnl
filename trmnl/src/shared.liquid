%}<svg class="gt-icon" viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}"><path d="{{ d }}"/></svg>{% endtemplate %}
{% liquid
  assign off = trmnl.user.utc_offset | default: 0 | plus: 0
  assign now = trmnl.system.timestamp_utc | default: ts | plus: 0
  assign cf = trmnl.plugin_settings.custom_fields_values
  assign stale_h = cf.stale_hours | default: 4 | plus: 0
  assign stale_s = stale_h | times: 3600
  assign age = now | minus: ts
  assign stale = false
  if ts == blank or age > stale_s
    assign stale = true
  endif
  assign auth_err = false
  if err == "auth"
    assign auth_err = true
  endif
  assign ts_hh = ts | plus: off | modulo: 86400 | divided_by: 3600 | plus: 100 | append: "" | slice: 1, 2
  assign ts_mi = ts | plus: off | modulo: 3600 | divided_by: 60 | plus: 100 | append: "" | slice: 1, 2
  assign age_h = age | divided_by: 3600

  # --- latest activity ---------------------------------------------------
  assign has_a = false
  if a.st
    assign has_a = true
  endif
  assign a_km = a.d | default: 0 | divided_by: 1000.0 | round: 1
  if a_km >= 100
    assign a_km = a_km | round
  endif
  assign a_mt = a.mt | default: a.t | default: 0 | plus: 0
  assign a_kind = "pace"
  if a.c == "ride"
    assign a_kind = "speed"
  endif
  assign a_rate = ""
  assign a_rate_unit = ""
  if a.d and a.d > 0 and a_mt > 0
    if a_kind == "speed"
      assign a_rate = a.d | times: 3.6 | divided_by: a_mt | round: 1
      assign a_rate_unit = "km/h"
    elsif a.c == "swim"
      assign a_rate_s = a_mt | times: 100 | divided_by: a.d | round
      assign a_rate_unit = "/100m"
    else
      assign a_rate_s = a_mt | times: 1000 | divided_by: a.d | round
      assign a_rate_unit = "/km"
    endif
  endif
  assign a_off = a.o | default: off
  assign a_has_d = false
  if a.d and a.d > 0
    assign a_has_d = true
  endif
  assign a_climb = false
  if a.c == "hike" or a.c == "walk"
    assign a_climb = true
  endif
  assign a_te = a.te[0] | times: 1.0 | round: 1
  # Headline stats, sport-specific. sNv value, sNu unit, sNl label, sNs short label.
  if a_has_d
    assign s1v = a_km
    assign s1u = "km"
    assign s1l = "Distance"
    assign s1s = "km"
  else
    assign s1v = a.kc | default: "-"
    assign s1u = ""
    assign s1l = "Calories"
    assign s1s = "kcal"
  endif
  capture s2v
    render "gt_dur", s: a_mt
  endcapture
  assign s2l = "Moving time"
  assign s2s = "moving"
  assign s3u = ""
  if a_climb
    assign s3v = a.el | default: "-"
    if a.el
      assign s3u = "m"
    endif
    assign s3l = "Ascent"
    assign s3s = "m up"
  elsif a_has_d and a_kind == "speed"
    assign s3v = a_rate
    assign s3u = "km/h"
    assign s3l = "Avg speed"
    assign s3s = "km/h"
  elsif a_has_d and a_rate_s
    capture s3v
      render "gt_pace", p: a_rate_s
    endcapture
    assign s3u = a_rate_unit
    assign s3l = "Avg pace"
    assign s3s = a_rate_unit
  else
    assign s3v = a.mx | default: "-"
    assign s3l = "Max HR"
    assign s3s = "max HR"
  endif
  # Second row (full, half_vertical): HR, elevation or kcal, load.
  if a_has_d == false
    assign s5v = a_te
    if a.te == nil
      assign s5v = "-"
    endif
    assign s5u = ""
    assign s5l = "Aerobic TE"
  elsif a_climb
    assign s5v = a.kc | default: "-"
    assign s5u = ""
    assign s5l = "Calories"
  else
    assign s5v = a.el | default: "-"
    assign s5u = "m"
    if a.el == nil
      assign s5u = ""
    endif
    assign s5l = "Elevation"
  endif
  assign a_sport = a.sp | default: "activity" | replace: "_", " " | capitalize
  assign a_name = a.n | default: a_sport

  # HR chart: "min,max,chars", one base64url char per bin (64 levels).
  assign hr_pts = ""
  assign hr_n = 0
  if a.h
    assign hp = a.h | split: ","
    assign hr_lo = hp[0]
    assign hr_hi = hp[1]
    assign hr_chars = hp[2]
    assign hr_n = hr_chars | size
    assign B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    assign last_i = hr_n | minus: 1
    for i in (0..last_i)
      assign ch = hr_chars | slice: i, 1
      assign lev = B64 | split: ch | first | size
      assign y = 63 | minus: lev
      assign hr_pts = hr_pts | append: i | append: "," | append: y | append: " "
    endfor
  endif

  # Splits: values are s per unit (run/hike/walk) or km/h x10 (ride).
  # Bar heights in %, taller = faster.
  assign spl_h = ""
  assign spl_n = 0
  assign spl_best = ""
  if a.spl
    assign sv = a.spl | split: ","
    assign spl_n = sv | size
    assign best = 0
    for v in sv
      assign x = v | plus: 0
      if a.c == "ride"
        if x > best
          assign best = x
        endif
      else
        if best == 0 or x < best
          assign best = x
        endif
      endif
    endfor
    for v in sv
      assign x = v | plus: 0
      if a.c == "ride"
        assign pct = x | times: 100 | divided_by: best
      else
        assign pct = best | times: 100 | divided_by: x
      endif
      # Exaggerate differences: map 60..100 % to 15..100 %.
      assign pct = pct | minus: 60 | at_least: 0 | times: 85 | divided_by: 40 | plus: 15
      assign spl_h = spl_h | append: pct | append: ","
    endfor
    assign spl_h = spl_h | split: ","
    if a.c == "ride"
      assign spl_best = best | divided_by: 10.0 | append: " km/h"
    else
      assign spl_best_s = best
    endif
  endif

  # --- wellness -----------------------------------------------------------
  assign st_name = w.tst | default: "" | replace: "_", " " | downcase | capitalize
  assign hrv_name = w.hrv | default: "" | replace: "_", " " | downcase
-%}
<style>
  .gt { height: 100%; width: 100%; box-sizing: border-box; }
  .gt * { box-sizing: border-box; }
  .gt-icon { display: block; fill: #000; flex: none; }
  .gt-map { position: relative; min-height: 0; min-width: 0; overflow: hidden;
            display: flex; align-items: center; justify-content: center; }
  .gt-map > svg { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
  .gt-route { fill: none; stroke: #000; stroke-linejoin: round; stroke-linecap: round; }
  .gt-nomap { width: 100%; height: 100%; border: 2px dashed #aaa; border-radius: 8px;
              display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
  .gt-stats { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 8px; row-gap: 4px; }
  .gt-stat { display: flex; flex-direction: column; min-width: 0; }
  .gt-stat .value, .gt-tile .value { white-space: nowrap; }
  .gt-unit { font-size: 60%; margin-left: 2px; }
  .gt-chart { position: relative; }
  .gt-chart svg { display: block; width: 100%; height: 100%; }
  .gt-hr { fill: none; stroke: #000; stroke-width: 2px; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .gt-hr-fill { fill: #aaa; stroke: none; }
  .gt-bars { display: flex; align-items: flex-end; gap: 2px; height: 100%; }
  .gt-bar { flex: 1 1 0; background: #555; min-width: 2px; }
  .gt-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .gt-col { display: flex; flex-direction: column; min-width: 0; }
  .gt-between { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .gt-tiles { display: grid; gap: 8px; }
  .gt-tile { border: 2px solid #000; border-radius: 8px; padding: 4px 8px; display: flex;
             flex-direction: column; justify-content: center; min-width: 0; overflow: hidden; }
  .gt-tile--dark { background: #000; }
  .gt-tile--dark .value, .gt-tile--dark .label { color: #fff; }
  .gt-ellip { white-space: nowrap; overflow: hidden; }
  .gt-banner { background: #000; color: #fff; border-radius: 8px; padding: 2px 10px; }
  .gt-banner .label { color: #fff; }
  .gt-chip { border: 2px solid #000; border-radius: 6px; padding: 0 6px; }
  .gt-chip .label { line-height: 19px !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  .gt-dim { color: #555; }
</style>
