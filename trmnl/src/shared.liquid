{% comment %}
gtrmnl shared markup. Merge variables (schema v1): docs/payload.md.
Settings (custom fields, trmnl/settings.yml): screen = latest | splits | heart |
week | recovery; map = route | streets | minimal | off; stale_hours.
Built from TRMNL framework components (item, value, label, title, table,
title_bar); custom CSS only for the route, charts and the calendar.
Icons: Material Design Icons (Apache 2.0), generated by trmnl/tools/icons.py.
{% endcomment %}
{% template gt_dur %}{% liquid
  assign s = s | plus: 0
  assign h = s | divided_by: 3600
  assign m = s | modulo: 3600 | divided_by: 60
  if h > 0
    assign mm = m | plus: 100 | append: "" | slice: 1, 2
    echo h | append: "h" | append: mm
  else
    echo m | append: "m"
  endif
%}{% endtemplate %}
{% template gt_pace %}{% liquid
  assign p = p | plus: 0
  assign mi = p | divided_by: 60
  assign se = p | modulo: 60 | plus: 100 | append: "" | slice: 1, 2
  echo mi | append: ":" | append: se
%}{% endtemplate %}
{% template gt_when %}{% liquid
  # t, off: start and UTC offset where the activity happened (clock time).
  # now, noff: render time and the viewer's offset (which day is "today").
  assign lt = t | plus: off
  assign noff = noff | default: off
  assign ln = now | plus: noff
  assign dt = lt | divided_by: 86400
  assign dn = ln | divided_by: 86400
  assign diff = dn | minus: dt
  assign hh = lt | modulo: 86400 | divided_by: 3600 | plus: 100 | append: "" | slice: 1, 2
  assign mi = lt | modulo: 3600 | divided_by: 60 | plus: 100 | append: "" | slice: 1, 2
  assign names = "Thu,Fri,Sat,Sun,Mon,Tue,Wed" | split: ","
  assign wd = dt | modulo: 7
  if diff < 1
    echo "Today " | append: hh | append: ":" | append: mi
  elsif diff == 1
    echo "Yesterday " | append: hh | append: ":" | append: mi
  elsif diff < 7
    echo names[wd] | append: " " | append: hh | append: ":" | append: mi
  else
    echo diff | append: " days ago"
  endif
%}{% endtemplate %}
